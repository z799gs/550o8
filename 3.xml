<Module>
<ModulePrefs title="-" />
<Content type="html"><![CDATA[


<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Security Warning</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18px;
  background: #100609;
  font-family: Arial, sans-serif;
  color: #fff;
}

.popup {
  width: 100%;
  max-width: 430px;
  text-align: center;
  background: #210e14;
  border: 2px solid #ff3030;
  border-radius: 18px;
  padding: 32px 22px;
  box-shadow: 0 0 65px #ff000040;
  animation: appear .35s ease-out;
}

.warning {
  font-size: 62px;
}

h1 {
  color: #ff4545;
  font-size: 28px;
  margin: 15px 0;
}

p {
  font-size: 17px;
  line-height: 1.5;
}

.danger {
  color: #ff9d9d;
  font-size: 19px;
  font-weight: bold;
}

.original-link {
  margin-top: 20px;
  padding: 17px 12px;
  background: #10291c;
  border: 2px solid #21b76a;
  border-radius: 10px;
  overflow-wrap: anywhere;
  user-select: text;
  -webkit-user-select: text;
}

.original-link a {
  color: #53ff9a;
  font-size: 20px;
  font-weight: bold;
  text-decoration: underline;
}

.link-title {
  color: #69ffab;
  font-size: 16px;
  font-weight: bold;
  margin-top: 22px;
}

.small {
  font-size: 13px;
  color: #c3aeb5;
  margin-top: 16px;
}

@keyframes appear {
  from {
    opacity: 0;
    transform: scale(.92);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}
</style>
</head>

<body>

<div class="popup" role="alert">

  <div class="warning">⚠️</div>

  <h1>UNSAFE WEBSITE!</h1>

  <p class="danger">
    WARNING: This unofficial website
    may contain viruses!
  </p>

  <p>
    Stop playing here.
    Protect your device and personal information.
  </p>

  <p class="link-title">
    ✅ VISIT THE ORIGINAL WEBSITE
  </p>

  <div class="original-link">
    <a href="https://sites.google.com/view/drive-u-7-home"
       target="_blank"
       rel="noopener noreferrer">
      https://sites.google.com/view/drive-u-7-home
    </a>
  </div>

  <p class="small">
    Copy the green link above and paste
    it into your browser to play safely.
  </p>

</div>

</body>
</html>


]]></Content>
</Module>
