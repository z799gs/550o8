  var PROBE = /^https?:\/\/fb\.[^/]+\/?\?.*ping=true/i;
  var LIST = /docs\.google\.com\/spreadsheets/i;
  var xOpen = XMLHttpRequest.prototype.open, xSend = XMLHttpRequest.prototype.send;
  XMLHttpRequest.prototype.open = function (method, url) {
    var u = String(url || '');
    this.__skip = PROBE.test(u) || LIST.test(u);
    return xOpen.apply(this, arguments);
  };
  XMLHttpRequest.prototype.send = function () {
    if (this.__skip) return;
